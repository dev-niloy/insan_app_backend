{
  "name": "solve-meet_prisma_server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "node ./dist/server.js",
    "start:prod": "node ./dist/server.js",
    "dev": "nodemon --exec ts-node src/server.ts",
    "db:migrate:prod": "prisma generate && prisma migrate deploy",
    "db:migrate:resolve": "prisma migrate resolve --applied",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --ignore-path .gitignore --write \"./src/**/*.+(js|ts|json)\"",
    "prettier:fix": "prettier --write src",
    "build:prod": "npm run build && npm run install:prod && npm run package",
    "build:dev": "npm run build && npm run install:dev && npm run package",
    "deploy:live": "prisma generate && rm -rf dist && npm run build:prod && scp dist.tar.gz prod-solvemeet:/home/solvemeet/solvemeet_backend_api",
    "deploy:dev": "prisma generate && rm -rf dist && npm run build:dev && scp dist.tar.gz dev-solvemeet:/home/solvemeet/solvemeet_backend_api",
    "extract": "rm -rf prisma/migrations/* && tar -xzvf dist.tar.gz && rm dist.tar.gz",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "seed:chat-packages": "node dist/app/modules/chat/ChatPackageSeeder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.958.0",
    "@aws-sdk/lib-storage": "^3.958.0",
    "@aws-sdk/s3-request-presigner": "^3.958.0",
    "@prisma/client": "^6.2.1",
    "axios": "^1.7.7",
    "bcrypt": "^5.1.1",
    "color-convert": "^3.1.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.1",
    "http-status": "^1.8.1",
    "jsonwebtoken": "^9.0.2",
    "sharp": "^0.34.4",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/eslint": "^8.56.12",
    "@types/express": "^4.17.21",
    "@types/http-status": "^0.2.30",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.5",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "7.8.0",
    "@typescript-eslint/parser": "7.8.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "prettier": "^3.3.3",
    "prisma": "^6.10.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
